# Analytics (optional). When configured, scripts stay off until the visitor accepts optional tracking.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Lead destination. Supabase is the recommended durable inbox for Vercel.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional CRM / automation destination.
# webhook works with tools such as Zapier, Make, or n8n after you provide a webhook URL.
CRM_PROVIDER=none
CRM_WEBHOOK_URL=
ZOHO_ACCESS_TOKEN=
ZOHO_API_DOMAIN=

# Public company identity. Keep blank on staging until the client provides approved details.
NEXT_PUBLIC_PHONE_DISPLAY=
NEXT_PUBLIC_PHONE_TEL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_COMPANY_LEGAL_NAME=MCAREVIVE
NEXT_PUBLIC_COMPANY_ADDRESS=
